# FinVault environment configuration
# Copy to .env and fill in real values. Every variable has a development
# fallback baked in, but the fallbacks are PUBLIC (they live in the repo) —
# always set real secrets outside local demos.

# ── Secrets ──────────────────────────────────────────────────────────
# Signs all access & refresh tokens (shared across services).
JWT_SECRET=

# Authenticates internal service-to-service calls (X-Service-Secret header).
SERVICE_SECRET=

# HMAC key for event/message integrity hashing.
FINVAULT_MESSAGE_KEY=

# ── Gateway ──────────────────────────────────────────────────────────
# Comma-separated CORS allowlist. Empty = allow all (local demo only).
CORS_ORIGINS=

# ── Service URLs (defaults match docker-compose / local dev) ─────────
# ACCOUNT_SERVICE_URL=http://localhost:8001
# WALLET_SERVICE_URL=http://localhost:8002
# INVOICE_SERVICE_URL=http://localhost:8003
# GATEWAY_URL=http://localhost:8000
#
# RabbitMQ — optional for local dev, required for async events (account.created,
# card.created, balance.updated, etc.).
# Quickstart (Docker required): docker run -d --name rabbitmq -p 5672:5672 rabbitmq:3
# Or start the full stack: docker-compose up rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── NexusInfra integration (optional) ────────────────────────────────
# The FinVault account that receives what NexusInfra customers pay to top up
# their hosting credit. Empty = FinVault ignores NexusInfra's payment requests.
# Needs RABBITMQ_URL, and FINVAULT_MESSAGE_KEY equal to NexusInfra's.
NEXUSINFRA_MERCHANT_EMAIL=

# ── Mobile app (apps/mobile/.env) ────────────────────────────────────
# Point Expo Go at the machine running the gateway:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
