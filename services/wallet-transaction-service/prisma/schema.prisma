datasource db {
  provider = "sqlite"
  url      = "file:./wallet.db"
}

generator client {
  provider = "prisma-client-js"
}

model Wallet {
  id              String           @id @default(uuid())
  userId          String
  iban            String           @unique
  currency        String           @default("EUR")
  type            String           @default("checking") // checking, savings
  interestRate    Float            @default(0.0)        // e.g. 0.025 for 2.5%
  balance         Float            @default(0.0)
  reservedBalance Float            @default(0.0)
  status          String           @default("active") // active, frozen
  createdAt       DateTime         @default(now())
  histories       BalanceHistory[]
  creditLine      CreditLine?
  cards           Card[]
}

model BalanceHistory {
  id           String   @id @default(uuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount       Float
  balanceAfter Float
  reason       String
  timestamp    DateTime @default(now())
}

model Transaction {
  id               String   @id @default(uuid())
  reference        String   @unique
  senderWalletId   String?
  receiverWalletId String?
  amount           Float
  currency         String   @default("EUR")
  status           String   @default("pending") // pending, processing, confirmed, failed, refunded
  type             String   // deposit, withdrawal, transfer, payment
  description      String
  integrityHash    String?  // HMAC-SHA256 of critical fields for tamper detection
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  statusCode   Int
  responseBody String   // JSON stringified response
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Fase 4 Credit/Debit System
model CreditLine {
  id           String   @id @default(uuid())
  walletId     String   @unique
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creditLimit  Float    @default(0.0)      // maximum credit amount
  usedCredit   Float    @default(0.0)      // how much credit is currently drawn
  interestRate Float    @default(0.15)     // 15% annual interest on credit debt
  status       String   @default("inactive") // inactive, active, suspended
  createdAt    DateTime @default(now())
}

model Card {
  id         String   @id @default(uuid())
  name       String
  kind       String   // physical, virtual
  network    String   // Visa, Mastercard
  last4      String
  number     String
  cvv        String
  holder     String
  exp        String
  frozen     Boolean  @default(false)
  scheme     String   // metal, cyan, etc.
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  monthSpend Float    @default(0.0)
  limit      Float    @default(2000.0)
  createdAt  DateTime @default(now())
}

model SavingsGoal {
  id        String   @id @default(uuid())
  userId    String
  name      String
  target    Float
  saved     Float    @default(0.0)
  hue       Int      @default(12)
  icon      String
  due       String   @default("No date")
  createdAt DateTime @default(now())
}

